# ============================================================
# GovGuide AI — .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
*.log

# --- Alembic ---
# keep versions/ tracked, but ignore generated __pycache__
database/migrations/versions/__pycache__/

# --- Node / Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example
*.tsbuildinfo

# --- Data (real dataset must never be committed) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Docker ---
.docker/

# --- Misc ---
*.tmp
*.bak
