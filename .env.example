# ============================================================
# GovGuide AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://govguide:changeme@localhost:5432/govguide_db
DATABASE_SYNC_URL=postgresql://govguide:changeme@localhost:5432/govguide_db

# --- JWT Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_QUERY_PER_MINUTE=10

# --- LLM (leave blank until model is selected) ---
LLM_PROVIDER=openai
LLM_API_KEY=REPLACE_WITH_YOUR_LLM_API_KEY
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.1

# --- Embedding (leave blank until model is confirmed) ---
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# --- Retrieval ---
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=GovGuide AI
